* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    user-select: none;
    font-family: 'Consolas', 'Courier New', monospace, sans-serif;
}

body {
    background-color: #030308;
    color: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    overflow: hidden;
}

#game-container {
    position: relative;
    width: 1280px;
    height: 720px;
    max-width: 100vw;
    max-height: 100vh;
    aspect-ratio: 16 / 9;
    box-shadow: 0 0 30px rgba(0, 243, 255, 0.15);
    border: 1px solid rgba(0, 243, 255, 0.3);
    background-color: #05050a;
    overflow: hidden;
}

canvas {
    width: 100%;
    height: 100%;
    display: block;
}

#hud {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.hud-top-left, .hud-top-right {
    position: absolute;
    top: 20px;
    display: flex;
    gap: 30px;
}

.hud-top-left { left: 20px; }
.hud-top-right { right: 20px; }

.hud-box {
    display: flex;
    flex-direction: column;
}

.hud-box.align-right {
    align-items: flex-end;
}

.hud-label {
    font-size: 12px;
    color: #00f3ff;
    letter-spacing: 2px;
    text-shadow: 0 0 5px rgba(0, 243, 255, 0.5);
}

.hud-value {
    font-size: 28px;
    font-weight: bold;
    color: #ffffff;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
}

.hud-value.highlight {
    color: #ff0055;
    text-shadow: 0 0 10px rgba(255, 0, 85, 0.8);
}

.hud-bottom {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    width: 450px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
}

.bar-container {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
}

.bar-label {
    width: 110px;
    font-size: 11px;
    color: #aaa;
    letter-spacing: 1px;
    text-align: right;
}

.bar-outer {
    flex: 1;
    height: 14px;
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    overflow: hidden;
    padding: 2px;
}

.bar-inner {
    height: 100%;
    width: 100%;
    transition: width 0.1s linear;
}

.hp-fill {
    background: linear-gradient(90deg, #ff0055, #ff5500);
    box-shadow: 0 0 8px #ff0055;
}

.energy-fill {
    background: linear-gradient(90deg, #0088ff, #00f3ff);
    box-shadow: 0 0 8px #00f3ff;
}

.bt-status-text {
    font-size: 12px;
    letter-spacing: 3px;
    color: #00f3ff;
    text-shadow: 0 0 8px #00f3ff;
    margin-top: 2px;
}

.xp-container {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.05);
}

.xp-fill {
    height: 100%;
    width: 0%;
    background: #ffcc00;
    box-shadow: 0 0 10px #ffcc00;
    transition: width 0.2s ease;
}

.overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(5, 5, 12, 0.88);
    backdrop-filter: blur(6px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 10;
    opacity: 1;
    transition: opacity 0.2s ease;
}

.overlay.hidden {
    display: none;
    opacity: 0;
    pointer-events: none;
}

.glitch-title {
    font-size: 72px;
    line-height: 0.9;
    text-align: center;
    letter-spacing: 6px;
    color: #fff;
    text-shadow: -2px 0 #ff0055, 2px 0 #00f3ff;
    margin-bottom: 10px;
}

.glitch-title span {
    color: #00f3ff;
    text-shadow: 0 0 20px #00f3ff;
}

.danger-title {
    font-size: 56px;
    color: #ff0055;
    text-shadow: 0 0 20px #ff0055;
    margin-bottom: 20px;
    letter-spacing: 4px;
}

.subtitle {
    font-size: 14px;
    letter-spacing: 8px;
    color: #888;
    margin-bottom: 20px;
}

.best-score-tag {
    font-size: 16px;
    color: #ffcc00;
    letter-spacing: 2px;
    margin-bottom: 30px;
    text-shadow: 0 0 10px rgba(255, 204, 0, 0.5);
}

.cyber-btn {
    background: transparent;
    border: 2px solid #00f3ff;
    color: #00f3ff;
    padding: 14px 40px;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 3px;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 0 15px rgba(0, 243, 255, 0.2);
    margin-top: 10px;
}

.cyber-btn:hover {
    background: #00f3ff;
    color: #000;
    box-shadow: 0 0 30px rgba(0, 243, 255, 0.8);
    transform: scale(1.05);
}

.controls-guide {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px 30px;
    font-size: 12px;
    color: #aaa;
}

.controls-guide span {
    color: #00f3ff;
    font-weight: bold;
}

.level-title {
    font-size: 42px;
    color: #ffcc00;
    text-shadow: 0 0 15px #ffcc00;
}

.level-subtitle {
    font-size: 14px;
    letter-spacing: 4px;
    color: #aaa;
    margin-bottom: 30px;
}

.cards-container {
    display: flex;
    gap: 20px;
}

.upgrade-card {
    width: 220px;
    height: 260px;
    background: rgba(15, 20, 30, 0.9);
    background-size: cover;
    background-position: center;
    border: 1px solid #00f3ff;
    border-radius: 4px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    overflow: hidden;
}

.upgrade-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(10, 15, 25, 0.75);
    z-index: 0;
}

.upgrade-card > * {
    position: relative;
    z-index: 1;
}

.upgrade-card:hover {
    transform: translateY(-10px);
    border-color: #ffcc00;
    box-shadow: 0 0 25px rgba(255, 204, 0, 0.4);
}

.card-title {
    font-size: 16px;
    font-weight: bold;
    color: #00f3ff;
    letter-spacing: 1px;
}

.upgrade-card:hover .card-title {
    color: #ffcc00;
}

.card-desc {
    font-size: 13px;
    color: #ccc;
    line-height: 1.4;
}

.card-tag {
    font-size: 10px;
    color: #888;
    letter-spacing: 2px;
}

.stats-summary {
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 20px 40px;
    margin-bottom: 25px;
    width: 360px;
}

.stat-row {
    display: flex;
    justify-content: space-between;
    margin: 10px 0;
    font-size: 14px;
    color: #aaa;
}

.stat-row span:last-child {
    color: #fff;
    font-weight: bold;
}
